@model List<NcsScheduler.Models.Domain.NetSession>
@using NcsScheduler.Models.Domain
@{ ViewData["Title"] = "Open Slots"; }
@{ int myControllerId = ViewBag.MyControllerId; }

<div class="mt-3">
    <h2>Open Slots</h2>
    <p class="text-muted">Sessions in your nets that need a net controller.</p>

    @if (!Model.Any())
    {
        <div class="alert alert-success">No open slots right now — all sessions are covered!</div>
    }
    else
    {
        <table class="table table-hover">
            <thead class="table-dark">
                <tr><th>Net</th><th>Date</th><th>Time (UTC)</th><th>Volunteers</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var session in Model)
                {
                    bool alreadyVolunteered = session.Assignments.Any(a =>
                        a.NetControllerId == myControllerId &&
                        a.AssignmentType == AssignmentType.Volunteer &&
                        a.Status != AssignmentStatus.Cancelled);

                    <tr>
                        <td>@session.Net?.Name</td>
                        <td class="text-nowrap">@session.SessionDate.ToString("ddd, MMMM d, yyyy")</td>
                        <td>@session.ScheduledTimeUtc.ToString("HH:mm")z</td>
                        <td>
                            @{
                                var volunteers = session.Assignments
                                    .Where(a => a.AssignmentType == AssignmentType.Volunteer && a.Status != AssignmentStatus.Cancelled)
                                    .ToList();
                            }
                            @if (volunteers.Any())
                            {
                                @string.Join(", ", volunteers.Select(a => a.NetController?.Callsign))
                            }
                            else
                            {
                                <span class="text-muted">None yet</span>
                            }
                        </td>
                        <td>
                            @if (alreadyVolunteered)
                            {
                                <span class="badge bg-warning text-dark">Volunteered</span>
                            }
                            else
                            {
                                <form asp-action="Volunteer" method="post" class="d-inline">
                                    <input type="hidden" name="sessionId" value="@session.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">Volunteer</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
