@model NcsScheduler.Models.ViewModels.DashboardViewModel
@using NcsScheduler.Models.Domain
@{ ViewData["Title"] = "Dashboard"; ViewData["HelpPage"] = "Net-Controller-User-Guide#your-dashboard"; }

<div class="row mt-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h2 class="mb-0">
            Dashboard
            @if (!string.IsNullOrEmpty(Model.Callsign))
            {
                <small class="text-muted fs-5 ms-2">@Model.CopyPaste</small>
            }
        </h2>
        <div>
            <a asp-controller="Unavailability" asp-action="Create" class="btn btn-outline-secondary btn-sm me-1">Mark Unavailable</a>
            <a asp-controller="Schedule" asp-action="Index" class="btn btn-outline-secondary btn-sm">View Full Schedule</a>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">

    <!-- Open Slots I Can Cover -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-danger text-white d-flex justify-content-between">
                <span>Open Slots</span>
                <span class="badge bg-white text-danger">@Model.OpenSlots.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.OpenSlots.Any())
                {
                    <p class="text-muted p-3 mb-0">No open slots right now.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>Net</th><th>Date</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var slot in Model.OpenSlots)
                            {
                                <tr>
                                    <td>@slot.NetName</td>
                                    <td class="text-nowrap">@slot.SessionDate.ToString("ddd M/d/yy") @slot.ScheduledTimeUtc.ToString("HH:mm")z</td>
                                    <td>
                                        @if (slot.AlreadyVolunteered)
                                        {
                                            <span class="badge bg-warning text-dark">Volunteered</span>
                                        }
                                        else
                                        {
                                            <form asp-controller="Volunteer" asp-action="Volunteer" method="post" class="d-inline">
                                                <input type="hidden" name="sessionId" value="@slot.SessionId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Volunteer</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Backup Requests -->
    @if (Model.BackupSessions.Any())
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-warning text-dark d-flex justify-content-between">
                    <span>Backup Requests</span>
                    <span class="badge bg-dark text-white">@Model.BackupSessions.Count</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>Net</th><th>Date</th><th>NCS</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var backup in Model.BackupSessions)
                            {
                                <tr>
                                    <td>@backup.NetName</td>
                                    <td class="text-nowrap">@backup.SessionDate.ToString("ddd M/d/yy") @backup.ScheduledTimeUtc.ToString("HH:mm")z</td>
                                    <td>@backup.RequestingNcsCallsign</td>
                                    <td>
                                        @if (backup.AlreadyStandingBy)
                                        {
                                            <span class="badge bg-success">Standing by</span>
                                        }
                                        else
                                        {
                                            <form asp-controller="Volunteer" asp-action="StandByAsBackup" method="post" class="d-inline">
                                                <input type="hidden" name="sessionId" value="@backup.SessionId" />
                                                <input type="hidden" name="returnTo" value="Dashboard" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning">Stand By</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- My Upcoming Nets -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span>My Upcoming Nets</span>
                @if (Model.IcalFeedUrl is not null)
                {
                    <button type="button" class="btn btn-sm btn-outline-light py-0"
                            data-bs-toggle="modal" data-bs-target="#icalModal"
                            title="Subscribe to your net schedule in any calendar app">📅 Subscribe</button>
                }
            </div>
            <div class="card-body p-0">
                @if (!Model.MyUpcomingNets.Any())
                {
                    <p class="text-muted p-3 mb-0">No nets scheduled in the next 14 days.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>Date (UTC)</th><th>Local</th><th>Net</th><th>Frequency</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.MyUpcomingNets)
                            {
                                var utcIso = $"{item.SessionDate:yyyy-MM-dd}T{item.ScheduledTimeUtc:HH:mm:ss}Z";
                                <tr>
                                    <td class="text-nowrap">
                                        @item.SessionDate.ToString("ddd M/d")
                                        <br /><small class="text-muted">@item.ScheduledTimeUtc.ToString("HH:mm")z</small>
                                    </td>
                                    <td class="text-nowrap small">
                                        <span class="local-time" data-utc="@utcIso">—</span>
                                    </td>
                                    <td>
                                        @item.NetName
                                        @if (item.IsSubstitute)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Sub</span>
                                        }
                                        @if (item.BackupRequested)
                                        {
                                            <br />
                                            <small class="text-warning fw-semibold">
                                                Backup requested (@item.BackupCount/2 standing by)
                                            </small>
                                        }
                                    </td>
                                    <td class="text-nowrap small font-monospace">
                                        @if (!string.IsNullOrEmpty(item.FrequencyMhz))
                                        {
                                            @item.FrequencyMhz
                                            @if (!string.IsNullOrEmpty(item.FrequencyRange))
                                            {
                                                <br /><span class="text-muted fw-normal">@item.FrequencyRange</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-nowrap">
                                        @if (item.SessionId.HasValue)
                                        {
                                            @if (item.BackupRequested)
                                            {
                                                <form asp-controller="Volunteer" asp-action="CancelBackupRequest" method="post" class="d-inline">
                                                    <input type="hidden" name="sessionId" value="@item.SessionId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Cancel Backup Request</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="Volunteer" asp-action="RequestBackup" method="post" class="d-inline">
                                                    <input type="hidden" name="sessionId" value="@item.SessionId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-warning">Request Backup</button>
                                                </form>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Net Preferences -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center"
                 style="cursor:pointer" data-bs-toggle="collapse" data-bs-target="#netPreferencesBody">
                <span>
                    My Net Preferences
                    <small class="ms-2">
                        @if (!Model.NetPreferenceIds.Any())
                        {
                            <span>All nets (default)</span>
                        }
                        else
                        {
                            <span>@Model.NetPreferenceIds.Count of @Model.AllNets.Count selected</span>
                        }
                    </small>
                </span>
                <span class="small">&#x25BE;</span>
            </div>
            <div class="collapse show" id="netPreferencesBody">
                <div class="card-body">
                    <p class="text-body-secondary small mb-2">
                        Select the nets you are willing to run. Open slots and backup requests for unselected nets
                        will not appear on your dashboard or in email notifications.
                        Leave all unchecked to see slots for all nets.
                    </p>
                    <form asp-controller="Schedule" asp-action="SavePreferences" method="post">
                        <div class="row g-2 mb-3">
                            @foreach (var net in Model.AllNets)
                            {
                                <div class="col-sm-6 col-lg-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="selectedNetIds"
                                               value="@net.Id" id="net-@net.Id"
                                               @(Model.NetPreferenceIds.Contains(net.Id) ? "checked" : "") />
                                        <label class="form-check-label" for="net-@net.Id">@net.Name</label>
                                    </div>
                                </div>
                            }
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary">Save Preferences</button>
                        @if (Model.NetPreferenceIds.Any())
                        {
                            <button type="submit" class="btn btn-sm btn-outline-secondary ms-2"
                                    onclick="document.querySelectorAll('[name=selectedNetIds]').forEach(c => c.checked = false)">
                                Clear All (show all nets)
                            </button>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Upcoming Holidays -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <span>Upcoming Holidays</span>
                <span class="badge bg-white text-info">@Model.UpcomingHolidays.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.UpcomingHolidays.Any())
                {
                    <p class="text-body-secondary p-3 mb-0">No upcoming holidays scheduled.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>Date</th><th>Day</th><th>Holiday</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.UpcomingHolidays)
                            {
                                <tr>
                                    <td class="text-nowrap">@h.Date.ToString("MMM d, yyyy")</td>
                                    <td>@h.Date.DayOfWeek.ToString()[..3]</td>
                                    <td class="fw-bold">@h.Name</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

</div>

@if (Model.IcalFeedUrl is not null)
{
<div class="modal fade" id="icalModal" tabindex="-1" aria-labelledby="icalModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="icalModalLabel">Subscribe to Calendar Feed</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-body-secondary small">
                    Copy this URL and add it as a subscription in your calendar app.
                    The feed updates every 6 hours and shows your next 90 days of net sessions.
                </p>
                <div class="input-group mb-3">
                    <input type="text" class="form-control form-control-sm font-monospace" id="icalUrl"
                           value="@Model.IcalFeedUrl" readonly />
                    <button class="btn btn-outline-primary btn-sm" type="button" id="copyIcalBtn">Copy</button>
                </div>
                <div id="copyConfirm" class="text-success small mb-3" style="display:none;">Copied to clipboard!</div>

                <p class="fw-bold mb-2">How to subscribe:</p>
                <div class="accordion accordion-flush" id="calInstructions">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed py-2" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#instrGoogle">
                                Google Calendar
                            </button>
                        </h2>
                        <div id="instrGoogle" class="accordion-collapse collapse" data-bs-parent="#calInstructions">
                            <div class="accordion-body small py-2">
                                <ol class="mb-0 ps-3">
                                    <li>Open <a href="https://calendar.google.com" target="_blank" rel="noopener noreferrer">Google Calendar</a> on a computer</li>
                                    <li>Click the <strong>+</strong> next to "Other calendars" in the left sidebar</li>
                                    <li>Select <strong>From URL</strong></li>
                                    <li>Paste the URL above and click <strong>Add calendar</strong></li>
                                </ol>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed py-2" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#instrOutlook">
                                Outlook / Outlook.com
                            </button>
                        </h2>
                        <div id="instrOutlook" class="accordion-collapse collapse" data-bs-parent="#calInstructions">
                            <div class="accordion-body small py-2">
                                <ol class="mb-0 ps-3">
                                    <li>Open Outlook and go to the <strong>Calendar</strong> view</li>
                                    <li>Click <strong>Add calendar</strong> &rarr; <strong>Subscribe from web</strong></li>
                                    <li>Paste the URL above, give it a name, and click <strong>Import</strong></li>
                                </ol>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed py-2" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#instrApple">
                                Apple Calendar (Mac / iOS)
                            </button>
                        </h2>
                        <div id="instrApple" class="accordion-collapse collapse" data-bs-parent="#calInstructions">
                            <div class="accordion-body small py-2">
                                <ol class="mb-0 ps-3">
                                    <li><strong>Mac:</strong> Open Calendar, go to <strong>File</strong> &rarr; <strong>New Calendar Subscription</strong>, paste the URL</li>
                                    <li><strong>iPhone/iPad:</strong> Go to <strong>Settings</strong> &rarr; <strong>Calendar</strong> &rarr; <strong>Accounts</strong> &rarr; <strong>Add Account</strong> &rarr; <strong>Other</strong> &rarr; <strong>Add Subscribed Calendar</strong>, paste the URL</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed py-2" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#instrAndroid">
                                Android
                            </button>
                        </h2>
                        <div id="instrAndroid" class="accordion-collapse collapse" data-bs-parent="#calInstructions">
                            <div class="accordion-body small py-2">
                                <p class="mb-1">Android's built-in Google Calendar app doesn't support URL subscriptions directly from the phone.</p>
                                <ol class="mb-0 ps-3">
                                    <li>Follow the <strong>Google Calendar</strong> instructions above using a computer or mobile browser at <a href="https://calendar.google.com" target="_blank" rel="noopener noreferrer">calendar.google.com</a></li>
                                    <li>The calendar will sync to your Android device automatically</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>

                <p class="text-body-secondary small mt-3 mb-0">
                    <strong>Keep this URL private</strong> &mdash; anyone with it can view your schedule.
                    <a href="https://github.com/MikeWills/net-scheduler/wiki/Net-Controller-User-Guide#calendar-feed"
                       target="_blank" rel="noopener noreferrer">More help in the documentation</a>.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
<script>
    document.querySelectorAll('.local-time[data-utc]').forEach(function (el) {
        var d = new Date(el.dataset.utc);
        el.textContent = d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
    });

    var copyBtn = document.getElementById('copyIcalBtn');
    if (copyBtn) {
        copyBtn.addEventListener('click', function () {
            var url = document.getElementById('icalUrl');
            navigator.clipboard.writeText(url.value).then(function () {
                var confirm = document.getElementById('copyConfirm');
                confirm.style.display = 'block';
                setTimeout(function () { confirm.style.display = 'none'; }, 3000);
            });
        });
    }
</script>
}
