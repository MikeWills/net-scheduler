@model NcsScheduler.Models.ViewModels.ScheduleViewModel
@using NcsScheduler.Models.Domain
@{
    ViewData["Title"] = "Net Schedule";

    // Build a lookup of net info keyed by NetId
    var netLookup = Model.Nets.ToDictionary(n => n.NetId);

    // Flatten all resolved slots, grouped by Eastern local calendar date.
    // Sessions are stored as UTC date + UTC time. Converting to Eastern Time means:
    //   03:00z Mon UTC → 11 PM Sun ET → grouped under Sunday
    //   05:00z Fri UTC →  1 AM Fri ET → grouped under Friday (same local day)
    // No server-side cutoff — JS hides day-groups more than 1 hour in the past.
    if (!TimeZoneInfo.TryFindSystemTimeZoneById("Eastern Standard Time", out var easternZone))
        TimeZoneInfo.TryFindSystemTimeZoneById("America/New_York", out easternZone);
    easternZone ??= TimeZoneInfo.Utc;

    DateOnly EasternDate(DateOnly utcDate, TimeOnly utcTime)
    {
        var utcDt = utcDate.ToDateTime(utcTime, DateTimeKind.Utc);
        return DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(utcDt, easternZone));
    }

    var allSlots = Model.Weeks
        .SelectMany(w => w.Slots.Values)
        .GroupBy(s => netLookup.TryGetValue(s.NetId, out var net)
            ? EasternDate(s.SessionDate, net.ScheduledTimeUtc)
            : s.SessionDate)
        .OrderBy(g => g.Key)
        .ToList();
}

<div class="px-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Net Schedule</h2>
        <div class="d-flex flex-wrap gap-1 align-items-center">
            <span class="badge bg-secondary">Regular</span>
            <span class="badge slot-open-badge">NCS Needed</span>
            <span class="badge slot-volunteer-badge">Volunteer Pending</span>
        </div>
    </div>

    @if (!allSlots.Any())
    {
        <div class="alert alert-info">No sessions scheduled in this window.</div>
    }
    else
    {
        @foreach (var day in allSlots)
        {
            var daySlots = day
                .OrderBy(s => netLookup.TryGetValue(s.NetId, out var n) ? n.ScheduledTimeUtc : TimeOnly.MinValue)
                .ThenBy(s => s.SessionDate)
                .ToList();
            <div class="day-group mb-4">
                <div class="day-header px-3 py-2 mb-0 rounded-top">
                    <strong class="day-header-text">
                        <span class="d-md-none">@day.Key.ToString("ddd, MMM d, yyyy")</span>
                        <span class="d-none d-md-inline">@day.Key.ToString("dddd, MMMM d, yyyy")</span>
                    </strong>
                </div>

                @* Mobile: card list (hidden on md+) *@
                <div class="d-md-none schedule-card-list border rounded-bottom">
                    @foreach (var slot in daySlots)
                    {
                        var net = netLookup.GetValueOrDefault(slot.NetId);
                        var utcIso = $"{slot.SessionDate:yyyy-MM-dd}T{net?.ScheduledTimeUtc:HH\\:mm\\:ss}Z";
                        <div class="schedule-card @slot.CssClass px-3 py-2">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="flex-grow-1" style="min-width:0">
                                    <div class="fw-semibold">@(net?.NetName ?? "—")</div>
                                    <div class="small text-muted">
                                        <span class="local-time" data-utc="@utcIso">—</span>
                                        @if (!string.IsNullOrWhiteSpace(net?.FrequencyMhz))
                                        {
                                            <span class="ms-2 font-monospace">@net.FrequencyMhz</span>
                                            @if (!string.IsNullOrWhiteSpace(net.FrequencyRange))
                                            {
                                                <span class="ms-1">@net.FrequencyRange</span>
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="text-end flex-shrink-0">
                                    @if (slot.NeedsNcs && !slot.HasVolunteer)
                                    {
                                        <span class="fw-bold text-danger small">NCS Needed</span>
                                    }
                                    else if (slot.HasVolunteer)
                                    {
                                        <span class="fw-bold text-warning small">Volunteer Pending</span>
                                    }
                                    else if (slot.CopyPasteFormat is not null)
                                    {
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <span class="font-monospace fw-semibold small">@slot.CopyPasteFormat</span>
                                        }
                                        else
                                        {
                                            <span class="font-monospace fw-semibold small">@slot.Callsign</span>
                                        }
                                        @if (slot.AssignmentType == AssignmentType.Substitute)
                                        {
                                            <div><span class="badge bg-info text-dark">sub</span></div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* Desktop: table (hidden below md) *@
                <div class="d-none d-md-block table-responsive">
                    <table class="table table-sm table-hover mb-0 border rounded-bottom">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th style="min-width:160px">Net</th>
                                <th style="min-width:140px">NCS</th>
                                <th class="text-nowrap">UTC</th>
                                <th class="text-nowrap">Local</th>
                                <th>Frequency</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var slot in daySlots)
                            {
                                var net = netLookup.GetValueOrDefault(slot.NetId);
                                var utcIso = $"{slot.SessionDate:yyyy-MM-dd}T{net?.ScheduledTimeUtc:HH\\:mm\\:ss}Z";
                                <tr class="@slot.CssClass" data-utc="@utcIso">
                                    <td>
                                        <span class="fw-semibold">@(net?.NetName ?? "—")</span>
                                    </td>
                                    <td>
                                        @if (slot.NeedsNcs && !slot.HasVolunteer)
                                        {
                                            <span class="fw-bold text-danger">NCS Needed</span>
                                        }
                                        else if (slot.HasVolunteer)
                                        {
                                            <span class="fw-bold text-warning">Volunteer Pending</span>
                                        }
                                        else if (slot.CopyPasteFormat is not null)
                                        {
                                            @if (User.Identity?.IsAuthenticated == true)
                                            {
                                                <span class="font-monospace">@slot.CopyPasteFormat</span>
                                            }
                                            else
                                            {
                                                <span>@slot.Callsign</span>
                                            }
                                            @if (slot.AssignmentType == AssignmentType.Substitute)
                                            {
                                                <span class="badge bg-info text-dark ms-1">sub</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-nowrap text-muted small">
                                        @(net?.ScheduledTimeUtc.ToString("HH:mm"))z
                                    </td>
                                    <td class="text-nowrap small">
                                        <span class="local-time" data-utc="@utcIso">—</span>
                                    </td>
                                    <td class="font-monospace small">
                                        @if (!string.IsNullOrWhiteSpace(net?.FrequencyMhz))
                                        {
                                            @net.FrequencyMhz
                                            if (!string.IsNullOrWhiteSpace(net.FrequencyRange))
                                            {
                                                <span class="text-muted ms-1">@net.FrequencyRange</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
<style>
    .day-header {
        background-color: #212529;
        color: #fff;
        font-size: 1rem;
    }
    .slot-open  { background-color: var(--bs-danger-bg-subtle) !important; }
    .slot-volunteer { background-color: var(--bs-warning-bg-subtle) !important; }
    .slot-normal    { background-color: inherit; }
    .slot-open-badge      { background-color: #dc3545 !important; }
    .slot-volunteer-badge { background-color: #ffc107 !important; color: #000 !important; }

    /* Mobile card list separators */
    .schedule-card-list > .schedule-card {
        border-bottom: 1px solid var(--bs-border-color);
    }
    .schedule-card-list > .schedule-card:last-child {
        border-bottom: 0;
    }
</style>
<script>
(function () {
    // 1. Convert UTC timestamps to local times in the Local/time columns.
    document.querySelectorAll('.local-time[data-utc]').forEach(function (el) {
        var d = new Date(el.dataset.utc);
        if (!isNaN(d)) {
            el.textContent = d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
        }
    });

    // 2. Hide day-groups whose LATEST session ended more than 1 hour ago (local time).
    //    The server intentionally includes yesterday's UTC date so that US-evening sessions
    //    (e.g. a net at 03:00z that falls on the previous local calendar day) are visible.
    //    Without this filter those stale UTC-date groups remain on screen even after the
    //    net has long since finished, causing the schedule to show a "wrong" time for the
    //    current day — especially visible on DST transition nights when a pre-transition
    //    session (10 PM EST) and the post-transition session (11 PM EDT) are both present.
    var cutoffMs = 60 * 60 * 1000; // 1 hour
    document.querySelectorAll('.day-group').forEach(function (group) {
        // Find the latest UTC session time in this group.
        var latestMs = -Infinity;
        group.querySelectorAll('[data-utc]').forEach(function (el) {
            var t = new Date(el.dataset.utc).getTime();
            if (!isNaN(t) && t > latestMs) latestMs = t;
        });
        // If even the latest session is more than 1 hour in the past, hide the whole group.
        if (latestMs !== -Infinity && Date.now() - latestMs > cutoffMs) {
            group.style.display = 'none';
        }
    });
})();
</script>
}
