@model string
@* Copies just the member number to the clipboard, for pasting into the OMISS
   admin site schedule. Icons are Font Awesome, loaded in _Layout. *@
<button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline copy-member-btn"
        data-member="@Model"
        title="Copy member number @Model"
        aria-label="Copy member number @Model">
    <i class="fa-regular fa-copy icon-copy" aria-hidden="true"></i>
    <i class="fa-solid fa-check icon-check" aria-hidden="true"></i>
</button>
