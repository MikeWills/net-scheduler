@model NcsScheduler.Models.ViewModels.BcCalendarViewModel
@using NcsScheduler.Models.Domain
@{
    ViewData["Title"] = "Weekly Calendar";
    ViewData["HelpPage"] = "Band-Coordinator-User-Guide#weekly-calendar";
    var days = Enumerable.Range(0, 7).Select(i => Model.WeekStart.AddDays(i)).ToList();

    var distinctBands = Model.Rows
        .Select(r => string.IsNullOrWhiteSpace(r.Net.Band) ? "Other" : r.Net.Band)
        .Distinct().OrderBy(b => BandHelper.SortKey(b)).ToList();
    bool showBandFilter = distinctBands.Count > 1;
}

<div class="px-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        @{
            int weekOffset = ViewBag.WeekOffset ?? 0;
        }
        <div>
            <h2 class="mb-0">Weekly Calendar</h2>
            <div class="d-flex align-items-center gap-2 mt-1">
                <a asp-action="Calendar" asp-route-offset="@(weekOffset - 1)"
                   class="btn btn-sm btn-outline-secondary py-0 px-1" title="Previous week">&laquo;</a>
                @if (weekOffset != 0)
                {
                    <a asp-action="Calendar" class="btn btn-sm btn-outline-primary py-0 px-1">Today</a>
                }
                <a asp-action="Calendar" asp-route-offset="@(weekOffset + 1)"
                   class="btn btn-sm btn-outline-secondary py-0 px-1" title="Next week">&raquo;</a>
                <span class="text-muted">
                    @Model.WeekStart.ToString("MMMM d") &ndash; @Model.WeekEnd.ToString("MMMM d, yyyy")
                    <span class="ms-2 badge bg-secondary">Compared to previous week</span>
                </span>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (showBandFilter)
            {
                <div class="d-flex flex-wrap gap-1 align-items-center" id="band-filter-btns">
                    <small class="text-muted me-1">Filter:</small>
                    <button type="button" class="btn btn-sm btn-secondary active" data-band-filter="all">All</button>
                    @foreach (var band in distinctBands)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-band-filter="@band">@band</button>
                    }
                </div>
            }
            @if (ViewBag.BcIcalFeedUrl is string bcIcalUrl)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        data-bs-toggle="modal" data-bs-target="#bcIcalModal"
                        title="Subscribe to your managed nets schedule in any calendar app">📅 Subscribe</button>
            }
            <a href="https://www.omiss.net/membership/admin/" target="_blank" class="btn btn-outline-secondary btn-sm">OMISS Admin Site</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Manage NCS Assignments</a>
        </div>
    </div>

    @if (!Model.Rows.Any())
    {
        <div class="alert alert-info">No nets are assigned to you for this week.</div>
    }
    else
    {
        @* Mobile: day-grouped card list (hidden md+) *@
        <div class="d-md-none cal-card-list">
            @for (int i = 0; i < 7; i++)
            {
                var day = days[i];
                var dayRows = Model.Rows.Where(r => r.Cells[i] is not null).ToList();
                if (dayRows.Any())
                {
                    <div class="cal-day-group">
                        <div class="cal-day-header px-3 py-2">
                            @day.ToString("dddd, MMM d")
                        </div>
                        @foreach (var row in dayRows)
                        {
                            var cell = row.Cells[i]!;
                            var rowBand = string.IsNullOrWhiteSpace(row.Net.Band) ? "Other" : row.Net.Band;
                            string rowClass = "cal-net-row px-3 py-2";
                            if (cell.IsChanged) rowClass += " cell-changed";
                            else if (cell.NeedsNcs && !cell.HasVolunteer) rowClass += " cell-open";

                            <div class="@rowClass" data-band="@rowBand">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-semibold">@row.Net.Name</div>
                                        <div class="text-muted small font-monospace">@row.Net.ScheduledTimeUtc.ToString("HH:mm")z</div>
                                    </div>
                                    <div class="text-end">
                                        @if (cell.NeedsNcs && !cell.HasVolunteer)
                                        {
                                            <span class="badge bg-danger">NCS Needed</span>
                                            if (!string.IsNullOrEmpty(cell.Callsign))
                                            {
                                                <div class="small text-muted mt-1">(@cell.Callsign out)</div>
                                            }
                                        }
                                        else if (cell.HasVolunteer)
                                        {
                                            <span class="badge bg-warning text-dark">Volunteer</span>
                                            <div class="font-monospace small mt-1">@cell.CopyPasteFormat</div>
                                        }
                                        else
                                        {
                                            <span class="font-monospace fw-semibold">@cell.CopyPasteFormat</span>
                                            @if (!string.IsNullOrWhiteSpace(cell.MemberNumber))
                                            {
                                                <partial name="_CopyMemberButton" model="cell.MemberNumber" />
                                            }
                                            @if (cell.AssignmentType == AssignmentType.Substitute)
                                            {
                                                <div><span class="badge bg-info text-dark mt-1">sub</span></div>
                                            }
                                            <div class="small text-muted mt-1">
                                                @if (cell.StandingNetNames.Any())
                                                {
                                                    <text>Regularly runs: @string.Join(", ", cell.StandingNetNames)<br /></text>
                                                }
                                                @(cell.LastScheduledDate.HasValue
                                                    ? "Last ran: " + cell.LastScheduledDate.Value.ToString("MMM d, yyyy")
                                                    : "Last ran: not in past 90 days")
                                            </div>
                                        }
                                    </div>
                                </div>
                                @if (cell.BackupRequested)
                                {
                                    <div class="mt-1">
                                        <span class="badge bg-warning text-dark" title="Backup requested">&#9888; Backup</span>
                                        @if (cell.BackupCallsigns.Any())
                                        {
                                            <span class="small text-muted ms-1">@string.Join(", ", cell.BackupCallsigns)</span>
                                        }
                                    </div>
                                }
                                @if (cell.IsChanged)
                                {
                                    <div class="change-note mt-1">
                                        @if (cell.PrevNeedsNcs)
                                        {
                                            <span>was: <em>open</em></span>
                                        }
                                        else if (!string.IsNullOrEmpty(cell.PrevCallsign))
                                        {
                                            <span>was: @cell.PrevCallsign</span>
                                        }
                                        else
                                        {
                                            <span>was: <em>unassigned</em></span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @* Desktop: grid table (hidden below md) *@
        <div class="d-none d-md-block table-responsive">
            <table class="table table-bordered bc-calendar align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="net-col">Net</th>
                        @foreach (var day in days)
                        {
                            <th class="text-center day-col">
                                @day.ToString("ddd")
                                <div class="fw-normal small opacity-75">@day.ToString("MMM d")</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var rowBand = string.IsNullOrWhiteSpace(row.Net.Band) ? "Other" : row.Net.Band;
                        <tr data-band="@rowBand">
                            <td class="net-name-cell">
                                <div class="fw-semibold">@row.Net.Name</div>
                                <div class="text-muted small font-monospace">@row.Net.ScheduledTimeUtc.ToString("HH:mm")z</div>
                            </td>
                            @for (int i = 0; i < 7; i++)
                            {
                                var cell = row.Cells[i];
                                if (cell is null)
                                {
                                    <td class="text-center cell-inactive"></td>
                                }
                                else
                                {
                                    string tdClass = "text-center";
                                    if (cell.IsChanged) tdClass += " cell-changed";
                                    else if (cell.NeedsNcs && !cell.HasVolunteer) tdClass += " cell-open";

                                    <td class="@tdClass">
                                        @if (cell.NeedsNcs && !cell.HasVolunteer)
                                        {
                                            <span class="badge bg-danger">NCS Needed</span>
                                            if (!string.IsNullOrEmpty(cell.Callsign))
                                            {
                                                <div class="small text-muted mt-1">(@cell.Callsign out)</div>
                                            }
                                        }
                                        else if (cell.HasVolunteer)
                                        {
                                            <span class="badge bg-warning text-dark">Volunteer</span>
                                            <div class="font-monospace small mt-1">@cell.CopyPasteFormat</div>
                                        }
                                        else
                                        {
                                            var popoverLines = new System.Text.StringBuilder();
                                                if (cell.StandingNetNames.Any())
                                                    popoverLines.Append("Regularly runs: " + string.Join(", ", cell.StandingNetNames));
                                                if (popoverLines.Length > 0) popoverLines.Append("<br>");
                                                popoverLines.Append(cell.LastScheduledDate.HasValue
                                                    ? "Last ran: " + cell.LastScheduledDate.Value.ToString("MMM d, yyyy")
                                                    : "Last ran: not in past 90 days");
                                                bool hasPopover = popoverLines.Length > 0;
                                            if (hasPopover)
                                            {
                                                <span class="font-monospace fw-semibold ncs-callsign"
                                                      tabindex="0"
                                                      data-bs-toggle="popover"
                                                      data-bs-trigger="hover focus"
                                                      data-bs-html="true"
                                                      data-bs-content="@popoverLines.ToString()">@cell.CopyPasteFormat</span>
                                            }
                                            else
                                            {
                                                <span class="font-monospace fw-semibold">@cell.CopyPasteFormat</span>
                                            }
                                            if (!string.IsNullOrWhiteSpace(cell.MemberNumber))
                                            {
                                                <partial name="_CopyMemberButton" model="cell.MemberNumber" />
                                            }
                                            if (cell.AssignmentType == AssignmentType.Substitute)
                                            {
                                                <div><span class="badge bg-info text-dark mt-1">sub</span></div>
                                            }
                                        }

                                        @if (cell.BackupRequested)
                                        {
                                            <div class="mt-1">
                                                <span class="badge bg-warning text-dark" title="Backup requested">&#9888; Backup</span>
                                                @if (cell.BackupCallsigns.Any())
                                                {
                                                    <div class="small text-muted">@string.Join(", ", cell.BackupCallsigns)</div>
                                                }
                                            </div>
                                        }

                                        @* Change annotation *@
                                        @if (cell.IsChanged)
                                        {
                                            <div class="change-note mt-1">
                                                @if (cell.PrevNeedsNcs)
                                                {
                                                    <span>was: <em>open</em></span>
                                                }
                                                else if (!string.IsNullOrEmpty(cell.PrevCallsign))
                                                {
                                                    <span>was: @cell.PrevCallsign</span>
                                                }
                                                else
                                                {
                                                    <span>was: <em>unassigned</em></span>
                                                }
                                            </div>
                                        }
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 d-flex flex-wrap gap-3 align-items-center small">
            <span class="d-flex align-items-center gap-1">
                <span class="legend-swatch bg-danger-subtle border border-danger-subtle"></span>
                NCS Needed
            </span>
            <span class="d-flex align-items-center gap-1">
                <span class="legend-swatch bg-warning-subtle border border-warning-subtle"></span>
                Changed from last week
            </span>
            <span class="d-flex align-items-center gap-1">
                <span class="badge bg-info text-dark">sub</span>
                One-time substitute
            </span>
            <span class="d-flex align-items-center gap-1">
                <span class="badge bg-warning text-dark">Volunteer</span>
                Volunteer pending confirmation
            </span>
            <span class="d-flex align-items-center gap-1">
                <span class="badge bg-warning text-dark">&#9888; Backup</span>
                Backup standby requested
            </span>
            <span class="d-flex align-items-center gap-1">
                <span class="ncs-callsign border-bottom border-secondary border-dotted">W1AW</span>
                Hover for NCS details
            </span>
            <span class="d-flex align-items-center gap-1">
                <i class="fa-regular fa-copy text-secondary" aria-hidden="true"></i>
                Copy member number
            </span>
        </div>
    }
</div>

@{
    if (ViewBag.BcIcalFeedUrl is string bcModalUrl)
    {
        ViewData["IcalModalUrl"] = bcModalUrl;
        ViewData["IcalModalId"] = "bcIcalModal";
    }
}
@if (ViewBag.BcIcalFeedUrl is string _)
{
    <partial name="_IcalSubscribeModal" view-data="ViewData" />
}

@section Scripts {
    <script src="~/js/ical-copy.js"></script>
    <style>
        .bc-calendar {
            font-size: .9rem;
        }

        .net-col {
            min-width: 140px;
            width: 140px;
        }

        .day-col {
            min-width: 120px;
        }

        .net-name-cell {
            vertical-align: middle;
        }

        /* Days where the net does not run */
        .cell-inactive {
            background-color: var(--bs-tertiary-bg);
        }

        /* Open slot */
        .cell-open {
            background-color: var(--bs-danger-bg-subtle);
        }

        /* Changed from last week */
        .cell-changed {
            background-color: var(--bs-warning-bg-subtle);
        }

        /* "was: …" annotation */
        .change-note {
            font-size: .75rem;
            color: var(--bs-secondary-color);
            font-style: italic;
        }

        /* Mobile day-grouped card list */
        .cal-card-list {
            border-top: 1px solid var(--bs-border-color);
        }
        .cal-day-group {
            border-bottom: 1px solid var(--bs-border-color);
        }
        .cal-day-group:last-child {
            border-bottom: 0;
        }
        .cal-day-header {
            background-color: #212529;
            color: #fff;
            font-weight: 600;
            font-size: .85rem;
        }
        [data-bs-theme="dark"] .cal-day-header {
            background-color: var(--bs-secondary-bg);
        }
        .cal-net-row + .cal-net-row {
            border-top: 1px solid var(--bs-border-color-translucent);
        }

        /* Legend swatches */
        .legend-swatch {
            display: inline-block;
            width: 14px;
            height: 14px;
            border-radius: 3px;
            flex-shrink: 0;
        }

        /* NCS callsign with hover tooltip indicator */
        .ncs-callsign[data-bs-toggle="popover"] {
            cursor: help;
            border-bottom: 1px dotted var(--bs-secondary-color);
        }

        /* Copy-member-number button (Font Awesome glyphs, inlined as SVG) */
        .copy-member-btn {
            color: var(--bs-secondary-color);
            text-decoration: none;
            vertical-align: baseline;
        }
        .copy-member-btn:hover {
            color: var(--bs-primary);
        }
        /* Show the copy glyph by default, the check only after a successful copy */
        .copy-member-btn .icon-check,
        .copy-member-btn.copied .icon-copy {
            display: none;
        }
        .copy-member-btn.copied .icon-check {
            display: inline;
        }
        .copy-member-btn.copied {
            color: var(--bs-success);
        }

        /* Keep table cells from getting too cramped on small screens */
        @@media (max-width: 768px) {
            .bc-calendar {
                font-size: .8rem;
            }

            .day-col {
                min-width: 90px;
            }
        }
    </style>
    <script>
    (function () {
        // Band filter buttons
        var filterBtns = document.querySelectorAll('#band-filter-btns [data-band-filter]');
        if (filterBtns.length) {
            filterBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    filterBtns.forEach(function (b) {
                        b.classList.remove('active', 'btn-secondary');
                        b.classList.add('btn-outline-secondary');
                    });
                    this.classList.remove('btn-outline-secondary');
                    this.classList.add('active', 'btn-secondary');

                    var filter = this.dataset.bandFilter;
                    document.querySelectorAll('tbody tr[data-band]').forEach(function (row) {
                        row.style.display = (filter === 'all' || row.dataset.band === filter) ? '' : 'none';
                    });
                    document.querySelectorAll('.cal-net-row[data-band]').forEach(function (row) {
                        row.style.display = (filter === 'all' || row.dataset.band === filter) ? '' : 'none';
                    });

                    // Hide mobile day-group cards left with no visible nets after filtering.
                    document.querySelectorAll('.cal-day-group').forEach(function (group) {
                        var anyVisible = Array.prototype.some.call(
                            group.querySelectorAll('.cal-net-row'),
                            function (row) { return row.style.display !== 'none'; }
                        );
                        group.style.display = anyVisible ? '' : 'none';
                    });
                });
            });
        }

        // Copy just the member number to the clipboard
        document.querySelectorAll('.copy-member-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var self = this;
                var num = self.dataset.member || '';

                function flash() {
                    self.classList.add('copied');
                    setTimeout(function () { self.classList.remove('copied'); }, 1500);
                }

                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(num).then(flash);
                } else {
                    // Fallback for non-secure contexts (e.g. plain http in dev)
                    var ta = document.createElement('textarea');
                    ta.value = num;
                    ta.style.position = 'fixed';
                    ta.style.opacity = '0';
                    document.body.appendChild(ta);
                    ta.select();
                    try { document.execCommand('copy'); flash(); } finally { document.body.removeChild(ta); }
                }
            });
        });

        // Bootstrap popovers for NCS callsigns
        document.querySelectorAll('[data-bs-toggle="popover"]').forEach(function (el) {
            new bootstrap.Popover(el, { placement: 'top' });
        });
    })();
    </script>
}
