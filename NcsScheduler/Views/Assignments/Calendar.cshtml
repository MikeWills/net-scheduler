@model NcsScheduler.Models.ViewModels.BcCalendarViewModel
@using NcsScheduler.Models.Domain
@{
    ViewData["Title"] = "Weekly Calendar";
    var days = Enumerable.Range(0, 7).Select(i => Model.WeekStart.AddDays(i)).ToList();

    var distinctBands = Model.Rows
        .Select(r => string.IsNullOrWhiteSpace(r.Net.Band) ? "Other" : r.Net.Band)
        .Distinct().OrderBy(b => BandHelper.SortKey(b)).ToList();
    bool showBandFilter = distinctBands.Count > 1;
}

<div class="px-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="mb-0">Weekly Calendar</h2>
            <span class="text-muted">
                @Model.WeekStart.ToString("MMMM d") &ndash; @Model.WeekEnd.ToString("MMMM d, yyyy")
                <span class="ms-2 badge bg-secondary">Compared to previous week</span>
            </span>
            @* TODO: Add previous/next week navigation so band coordinators can browse historical and future weeks.
                 The Calendar action should accept an optional `weekOf` date parameter (defaults to current week).
                 Render Prev/Next buttons linking to Calendar?weekOf=<ISO date> for the adjacent Sunday.
                 Restrict navigation to reasonable bounds (e.g. no more than 52 weeks back or 8 weeks forward). *@
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (showBandFilter)
            {
                <div class="d-flex flex-wrap gap-1 align-items-center" id="band-filter-btns">
                    <small class="text-muted me-1">Filter:</small>
                    <button type="button" class="btn btn-sm btn-secondary active" data-band-filter="all">All</button>
                    @foreach (var band in distinctBands)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-band-filter="@band">@band</button>
                    }
                </div>
            }
            @if (ViewBag.BcIcalFeedUrl is string bcIcalUrl)
            {
                <a href="@bcIcalUrl" class="btn btn-outline-secondary btn-sm"
                   title="Subscribe to your managed nets schedule in any calendar app">📅 Subscribe</a>
            }
            <a href="https://www.omiss.net/membership/admin/" target="_blank" class="btn btn-outline-secondary btn-sm">OMISS Admin Site</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Manage NCS Assignments</a>
        </div>
    </div>

    @if (!Model.Rows.Any())
    {
        <div class="alert alert-info">No nets are assigned to you for this week.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered bc-calendar align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="net-col">Net</th>
                        @foreach (var day in days)
                        {
                            <th class="text-center day-col">
                                @day.ToString("ddd")
                                <div class="fw-normal small opacity-75">@day.ToString("MMM d")</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var rowBand = string.IsNullOrWhiteSpace(row.Net.Band) ? "Other" : row.Net.Band;
                        <tr data-band="@rowBand">
                            <td class="net-name-cell">
                                <div class="fw-semibold">@row.Net.Name</div>
                                <div class="text-muted small font-monospace">@row.Net.ScheduledTimeUtc.ToString("HH:mm")z</div>
                            </td>
                            @for (int i = 0; i < 7; i++)
                            {
                                var cell = row.Cells[i];
                                if (cell is null)
                                {
                                    <td class="text-center cell-inactive"></td>
                                }
                                else
                                {
                                    string tdClass = "text-center";
                                    if (cell.IsChanged) tdClass += " cell-changed";
                                    else if (cell.NeedsNcs && !cell.HasVolunteer) tdClass += " cell-open";

                                    <td class="@tdClass">
                                        @if (cell.NeedsNcs && !cell.HasVolunteer)
                                        {
                                            <span class="badge bg-danger">NCS Needed</span>
                                            if (!string.IsNullOrEmpty(cell.Callsign))
                                            {
                                                <div class="small text-muted mt-1">(@cell.Callsign out)</div>
                                            }
                                        }
                                        else if (cell.HasVolunteer)
                                        {
                                            <span class="badge bg-warning text-dark">Volunteer</span>
                                            <div class="font-monospace small mt-1">@cell.CopyPasteFormat</div>
                                        }
                                        else
                                        {
                                            @{
                                                // Build popover content for the NCS callsign
                                                var popoverLines = new System.Text.StringBuilder();
                                                if (cell.StandingNetNames.Any())
                                                    popoverLines.Append("Regularly runs: " + string.Join(", ", cell.StandingNetNames));
                                                if (popoverLines.Length > 0) popoverLines.Append("<br>");
                                                popoverLines.Append(cell.LastScheduledDate.HasValue
                                                    ? "Last ran: " + cell.LastScheduledDate.Value.ToString("MMM d, yyyy")
                                                    : "Last ran: not in past 90 days");
                                                bool hasPopover = popoverLines.Length > 0;
                                            }
                                            @if (hasPopover)
                                            {
                                                <span class="font-monospace fw-semibold ncs-callsign"
                                                      tabindex="0"
                                                      data-bs-toggle="popover"
                                                      data-bs-trigger="hover focus"
                                                      data-bs-html="true"
                                                      data-bs-content="@popoverLines.ToString()">@cell.CopyPasteFormat</span>
                                            }
                                            else
                                            {
                                                <span class="font-monospace fw-semibold">@cell.CopyPasteFormat</span>
                                            }
                                            if (cell.AssignmentType == AssignmentType.Substitute)
                                            {
                                                <div><span class="badge bg-info text-dark mt-1">sub</span></div>
                                            }
                                        }

                                        @if (cell.BackupRequested)
                                        {
                                            <div class="mt-1">
                                                <span class="badge bg-warning text-dark" title="Backup requested">&#9888; Backup</span>
                                                @if (cell.BackupCallsigns.Any())
                                                {
                                                    <div class="small text-muted">@string.Join(", ", cell.BackupCallsigns)</div>
                                                }
                                            </div>
                                        }

                                        @* TODO: Always display who ran this same day last week, even when nothing
                                             changed. PrevCallsign (and PrevNeedsNcs) are already populated on
                                             CalendarCell for change detection — reuse them to show a subtle
                                             "last week: W1AW" line beneath the current assignment in every
                                             cell where the net ran last week (PrevCallsign not null / PrevNeedsNcs
                                             false). Style it smaller/muted so it doesn't compete with today's NCS. *@

                                        @* Change annotation *@
                                        @if (cell.IsChanged)
                                        {
                                            <div class="change-note mt-1">
                                                @if (cell.PrevNeedsNcs)
                                                {
                                                    <span>was: <em>open</em></span>
                                                }
                                                else if (!string.IsNullOrEmpty(cell.PrevCallsign))
                                                {
                                                    <span>was: @cell.PrevCallsign</span>
                                                }
                                                else
                                                {
                                                    <span>was: <em>unassigned</em></span>
                                                }
                                            </div>
                                        }
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 d-flex flex-wrap gap-3 align-items-center small">
            <span class="d-flex align-items-center gap-1">
                <span class="legend-swatch bg-danger-subtle border border-danger-subtle"></span>
                NCS Needed
            </span>
            <span class="d-flex align-items-center gap-1">
                <span class="legend-swatch bg-warning-subtle border border-warning-subtle"></span>
                Changed from last week
            </span>
            <span class="d-flex align-items-center gap-1">
                <span class="badge bg-info text-dark">sub</span>
                One-time substitute
            </span>
            <span class="d-flex align-items-center gap-1">
                <span class="badge bg-warning text-dark">Volunteer</span>
                Volunteer pending confirmation
            </span>
            <span class="d-flex align-items-center gap-1">
                <span class="badge bg-warning text-dark">&#9888; Backup</span>
                Backup standby requested
            </span>
            <span class="d-flex align-items-center gap-1">
                <span class="ncs-callsign border-bottom border-secondary border-dotted">W1AW</span>
                Hover for NCS details
            </span>
        </div>
    }
</div>

@section Scripts {
    <style>
        .bc-calendar {
            font-size: .9rem;
        }

        .net-col {
            min-width: 140px;
            width: 140px;
        }

        .day-col {
            min-width: 120px;
        }

        .net-name-cell {
            vertical-align: middle;
        }

        /* Days where the net does not run */
        .cell-inactive {
            background-color: var(--bs-tertiary-bg);
        }

        /* Open slot */
        .cell-open {
            background-color: var(--bs-danger-bg-subtle);
        }

        /* Changed from last week */
        .cell-changed {
            background-color: var(--bs-warning-bg-subtle);
        }

        /* "was: …" annotation */
        .change-note {
            font-size: .75rem;
            color: var(--bs-secondary-color);
            font-style: italic;
        }

        /* Legend swatches */
        .legend-swatch {
            display: inline-block;
            width: 14px;
            height: 14px;
            border-radius: 3px;
            flex-shrink: 0;
        }

        /* NCS callsign with hover tooltip indicator */
        .ncs-callsign[data-bs-toggle="popover"] {
            cursor: help;
            border-bottom: 1px dotted var(--bs-secondary-color);
        }

        /* Keep table cells from getting too cramped on small screens */
        @@media (max-width: 768px) {
            .bc-calendar {
                font-size: .8rem;
            }

            .day-col {
                min-width: 90px;
            }
        }
    </style>
    <script>
    (function () {
        // Band filter buttons
        var filterBtns = document.querySelectorAll('#band-filter-btns [data-band-filter]');
        if (filterBtns.length) {
            filterBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    filterBtns.forEach(function (b) {
                        b.classList.remove('active', 'btn-secondary');
                        b.classList.add('btn-outline-secondary');
                    });
                    this.classList.remove('btn-outline-secondary');
                    this.classList.add('active', 'btn-secondary');

                    var filter = this.dataset.bandFilter;
                    document.querySelectorAll('tbody tr[data-band]').forEach(function (row) {
                        row.style.display = (filter === 'all' || row.dataset.band === filter) ? '' : 'none';
                    });
                });
            });
        }

        // Bootstrap popovers for NCS callsigns
        document.querySelectorAll('[data-bs-toggle="popover"]').forEach(function (el) {
            new bootstrap.Popover(el, { placement: 'top' });
        });
    })();
    </script>
}
