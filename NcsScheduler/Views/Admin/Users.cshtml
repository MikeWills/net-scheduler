@model List<NcsScheduler.Models.ViewModels.UserRoleViewModel>
@{ ViewData["Title"] = "Manage Users"; }

<div class="container-fluid py-4">
    <h2 class="mb-1">Manage Users</h2>
    <p class="text-muted mb-4">Grant or revoke Admin access and manage Coordinator roles.</p>

    @* ── Role mismatch warning banner ─────────────────────────────────────── *@
    @{
        var mismatched = Model.Where(u => u.CoordinatorRoleMissing).ToList();
    }
    @if (mismatched.Any())
    {
        <div class="alert alert-warning d-flex align-items-start gap-2 mb-4">
            <span class="fs-5">⚠️</span>
            <div>
                <strong>Role sync needed</strong> —
                @if (mismatched.Count == 1)
                {
                    <span>@(mismatched[0].Callsign ?? mismatched[0].Email) is</span>
                }
                else
                {
                    <span>@mismatched.Count users are</span>
                }
                listed as a Band Coordinator in the database but
                @(mismatched.Count == 1 ? "is" : "are")
                missing the Coordinator role. This usually happens when a controller is promoted
                <em>before</em> they create their account. Click <strong>Fix Role</strong> to resolve it.
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Callsign</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr class="@(u.CoordinatorRoleMissing ? "table-warning" : "")">
                            <td class="fw-bold font-monospace">@(u.Callsign ?? "—")</td>
                            <td>@(u.Name ?? u.Email)</td>
                            <td class="text-muted small">@u.Email</td>
                            <td>
                                <div class="d-flex flex-wrap gap-1 align-items-center">
                                    @if (u.IsSuperAdmin)
                                    {
                                        <span class="badge bg-danger">Admin</span>
                                    }
                                    @if (u.IsCoordinator)
                                    {
                                        <span class="badge bg-warning text-dark">Coordinator</span>
                                    }
                                    @if (u.IsNetController && !u.IsSuperAdmin && !u.IsCoordinator)
                                    {
                                        <span class="badge bg-secondary">Net Controller</span>
                                    }
                                    @if (!u.Roles.Any())
                                    {
                                        <span class="badge bg-light text-muted border">No role</span>
                                    }
                                    @if (u.IsCurrentUser)
                                    {
                                        <span class="badge bg-info text-dark">You</span>
                                    }
                                    @if (u.CoordinatorRoleMissing)
                                    {
                                        <span class="badge bg-warning text-dark border border-warning-emphasis"
                                              title="Coordinator DB record exists but Identity role is missing">
                                            ⚠ Role missing
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end flex-wrap">

                                    @* ── Fix missing coordinator role ─────────── *@
                                    @if (u.CoordinatorRoleMissing)
                                    {
                                        <form asp-action="GrantCoordinator" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.UserId" />
                                            <button type="submit" class="btn btn-sm btn-warning fw-semibold">
                                                Fix Role
                                            </button>
                                        </form>
                                    }

                                    @* ── Admin grant/revoke ───────────────────── *@
                                    @if (!u.IsSuperAdmin)
                                    {
                                        <form asp-action="GrantAdmin" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.UserId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Grant Admin to @Html.Raw(u.Callsign ?? u.Email)?')">
                                                Grant Admin
                                            </button>
                                        </form>
                                    }
                                    else if (!u.IsCurrentUser)
                                    {
                                        <form asp-action="RevokeAdmin" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.UserId" />
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Revoke Admin from @Html.Raw(u.Callsign ?? u.Email)?')">
                                                Revoke Admin
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-danger" disabled title="You cannot revoke your own admin access">
                                            Revoke Admin
                                        </button>
                                    }

                                    @* ── Coordinator demotion ─────────────────── *@
                                    @if (u.IsCoordinator && !u.IsCurrentUser)
                                    {
                                        <form asp-action="DemoteCoordinator" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.UserId" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning"
                                                    onclick="return confirm('Remove Coordinator role from @Html.Raw(u.Callsign ?? u.Email)? Their net assignments will be ended.')">
                                                Demote Coordinator
                                            </button>
                                        </form>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Admin Dashboard</a>
    </div>
</div>
