@using System.Reflection
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NCS Scheduler</title>
    <script>
        // Apply saved theme before CSS loads to prevent light→dark flash
        (function () {
            var t = localStorage.getItem('ncs-theme');
            if (t) document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Source+Sans+3:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NcsScheduler.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Schedule" asp-action="Index">
                    NCS Scheduler
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-xl-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Schedule" asp-action="Index">Net Schedule</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Schedule" asp-action="Dashboard">NCS Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Unavailability" asp-action="Index">My Unavailability</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Volunteer" asp-action="Index">Open Nets</a>
                            </li>

                            @if (User.IsInRole("BandCoordinator") || User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-white" href="#" role="button"
                                       data-bs-toggle="dropdown">Band Coordinator</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Assignments" asp-action="Index">Manage Assignments</a></li>
                                        <li><a class="dropdown-item" asp-controller="Assignments" asp-action="Calendar">Weekly Calendar</a></li>
                                        <li><a class="dropdown-item" asp-controller="Controllers" asp-action="Index">Net Controllers</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Holidays" asp-action="Index">Holiday Schedule</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-white" href="#" role="button"
                                       data-bs-toggle="dropdown">Directors/Admin</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Nets" asp-action="Index">Manage Nets</a></li>
                                        <li><a class="dropdown-item" asp-controller="Coordinators" asp-action="Index">Band Coordinators</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">Manage Users</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Admin Dashboard</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item px-1">
                            <button id="theme-toggle" class="btn btn-link text-white p-0 border-0 fs-5 lh-1"
                                    title="Toggle light/dark mode" aria-label="Toggle colour theme">🌙</button>
                        </li>
                        @{
                            var wikiBase = "https://github.com/MikeWills/net-scheduler/wiki";
                            var helpPage = ViewData["HelpPage"] as string;
                            var helpUrl = string.IsNullOrEmpty(helpPage) ? wikiBase : $"{wikiBase}/{helpPage}";
                        }
                        <li class="nav-item px-1">
                            <a href="@helpUrl" target="_blank" rel="noopener noreferrer"
                               class="nav-link text-white-50 p-0" title="Help / Documentation"
                               style="text-decoration:none;" aria-label="Help">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                    <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286m1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94"/>
                                </svg>
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" role="button"
                                   data-bs-toggle="dropdown">@User.Identity.Name</a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">My Profile</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Log in</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show mx-3" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show mx-3" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @{
        var appVersion = Assembly.GetEntryAssembly()?
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
            .InformationalVersion;
    }
    <footer class="border-top footer text-muted mt-4">
        <div class="container">
            &copy; @DateTime.Now.Year - NCS Scheduler
            @if (!string.IsNullOrEmpty(appVersion))
            {
                <span class="ms-2">@appVersion</span>
            }
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('select.nc-select').forEach(function (el) {
                var ts = new TomSelect(el, {
                    create: false,
                    // Render the dropdown as a direct child of <body> so it is never
                    // clipped by overflow:hidden on ancestor elements (e.g. table-responsive).
                    dropdownParent: 'body'
                });
                // Propagate flex-grow to Tom Select's wrapper (needed inside flex table cells)
                if (el.classList.contains('flex-grow-1')) {
                    ts.wrapper.classList.add('flex-grow-1');
                }
            });
        });
    </script>
    <script>
        (function () {
            var html = document.documentElement;
            var btn = document.getElementById('theme-toggle');
            function getTheme() { return html.getAttribute('data-bs-theme') || 'light'; }
            function updateBtn(theme) { btn.textContent = theme === 'dark' ? '☀️' : '🌙'; }
            updateBtn(getTheme());
            btn.addEventListener('click', function () {
                var next = getTheme() === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-bs-theme', next);
                localStorage.setItem('ncs-theme', next);
                updateBtn(next);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
