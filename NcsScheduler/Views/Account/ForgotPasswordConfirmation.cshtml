@{ ViewData["Title"] = "Check Your Email"; }

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Check Your Email</h4>
            </div>
            <div class="card-body text-center py-4">
                <i class="bi bi-envelope-check fs-1 text-success mb-3 d-block"></i>
                <p>
                    If an account with that email address exists, a password reset link has been sent.
                    Please check your inbox (and spam folder).
                </p>
                <p class="text-muted small">The link expires in 24 hours.</p>
            </div>
            <div class="card-footer text-center">
                <a asp-action="Login" class="text-decoration-none">Back to Log In</a>
            </div>
        </div>
    </div>
</div>
