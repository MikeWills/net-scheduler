@model NcsScheduler.Models.ViewModels.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot Password"; ViewData["HelpPage"] = "Net-Controller-User-Guide#password-reset"; }

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Forgot Password</h4>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">
                    Enter your email address and we'll send you a link to reset your password.
                </p>
                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
                </form>
            </div>
            <div class="card-footer text-center">
                <a asp-action="Login" class="text-decoration-none">Back to Log In</a>
            </div>
        </div>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
