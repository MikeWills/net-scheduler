@model NcsScheduler.Models.ViewModels.ProfileViewModel
@{ ViewData["Title"] = "My Profile"; }

<div class="row justify-content-center mt-3">
    <div class="col-md-7">
        <h2>My Profile</h2>
        <div class="card mb-3">
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-4 text-muted">Callsign</div>
                    <div class="col-8 fw-bold">@Model.Callsign</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.MemberNumber))
                {
                    <div class="row mb-2">
                        <div class="col-4 text-muted">Member #</div>
                        <div class="col-8">@Model.MemberNumber</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4 text-muted">Copy-paste format</div>
                        <div class="col-8 font-monospace">@Model.Callsign #@Model.MemberNumber</div>
                    </div>
                }
            </div>
        </div>

        <form asp-action="Profile" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" type="tel" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <h5 class="mt-4">Email Notifications</h5>
            <div class="mb-2 form-check">
                <input asp-for="NotifyOnSlotOpened" class="form-check-input" />
                <label asp-for="NotifyOnSlotOpened" class="form-check-label"></label>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="NotifyOnAssigned" class="form-check-input" />
                <label asp-for="NotifyOnAssigned" class="form-check-label"></label>
            </div>

            <h5 class="mt-4">Change Password</h5>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-dark">Save Changes</button>
        </form>

        @if (Model.IcalFeedUrl is not null)
        {
            <div class="card mt-4">
                <div class="card-header bg-transparent border-bottom d-flex align-items-center gap-2">
                    <span>📅</span>
                    <h5 class="mb-0">Calendar Feed</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Subscribe to this URL in any calendar app (Google Calendar, Apple Calendar,
                        Outlook, etc.) to see your upcoming net control sessions.
                        The feed covers the next 90 days and refreshes every 6 hours.
                    </p>
                    <div class="input-group mb-3">
                        <input type="text" id="icalUrl" class="form-control font-monospace small"
                               value="@Model.IcalFeedUrl" readonly />
                        <button class="btn btn-outline-secondary" type="button" id="copyIcalBtn"
                                onclick="copyIcalUrl()">Copy</button>
                    </div>
                    <a href="@Model.IcalFeedUrl" class="btn btn-sm btn-outline-dark"
                       download="ncs-schedule.ics">⬇ Download .ics file</a>
                    <p class="text-muted small mt-3 mb-0">
                        <strong>Keep this URL private</strong> — anyone with it can view your schedule.
                        Contact your administrator if you need it reset.
                    </p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
    function copyIcalUrl() {
        navigator.clipboard.writeText(document.getElementById('icalUrl').value).then(function () {
            var btn = document.getElementById('copyIcalBtn');
            btn.textContent = 'Copied!';
            btn.classList.replace('btn-outline-secondary', 'btn-success');
            setTimeout(function () {
                btn.textContent = 'Copy';
                btn.classList.replace('btn-success', 'btn-outline-secondary');
            }, 2000);
        });
    }
    </script>
}
