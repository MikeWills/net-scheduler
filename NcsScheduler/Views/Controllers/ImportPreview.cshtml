@model NcsScheduler.Models.ViewModels.ImportPreviewViewModel
@{ ViewData["Title"] = "Import Preview"; }

<div class="mt-3">
    <h2>Import Preview</h2>
    <p class="text-muted">Review the rows below before confirming the import.</p>

    @if (Model.InvalidRows.Count > 0)
    {
        <h5 class="text-danger mt-4">
            <span class="badge bg-danger">@Model.InvalidRows.Count</span>
            Row@(Model.InvalidRows.Count == 1 ? "" : "s") with errors — will not be imported
        </h5>
        <table class="table table-sm table-bordered mb-4">
            <thead class="table-danger">
                <tr>
                    <th>Callsign</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Member #</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invalid in Model.InvalidRows)
                {
                    <tr class="table-danger">
                        <td class="font-monospace">@invalid.Row.Callsign</td>
                        <td>@invalid.Row.Name</td>
                        <td>@invalid.Row.Email</td>
                        <td>@invalid.Row.Phone</td>
                        <td>@invalid.Row.MemberNumber</td>
                        <td class="text-danger fw-semibold">@invalid.Error</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.ValidRows.Count > 0)
    {
        <h5 class="text-success mt-4">
            <span class="badge bg-success">@Model.ValidRows.Count</span>
            Row@(Model.ValidRows.Count == 1 ? "" : "s") ready to import
        </h5>
        <form asp-action="ConfirmImport" method="post">
            @Html.AntiForgeryToken()
            @for (int i = 0; i < Model.ValidRows.Count; i++)
            {
                var row = Model.ValidRows[i];
                <input type="hidden" name="rows[@i].Callsign"     value="@row.Callsign" />
                <input type="hidden" name="rows[@i].Name"         value="@row.Name" />
                <input type="hidden" name="rows[@i].Email"        value="@row.Email" />
                <input type="hidden" name="rows[@i].Phone"        value="@row.Phone" />
                <input type="hidden" name="rows[@i].MemberNumber" value="@row.MemberNumber" />
            }
            <table class="table table-sm table-bordered mb-3">
                <thead class="table-success">
                    <tr>
                        <th>Callsign</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Member #</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.ValidRows)
                    {
                        <tr>
                            <td class="font-monospace fw-bold">@row.Callsign</td>
                            <td>@row.Name</td>
                            <td>@row.Email</td>
                            <td>@row.Phone</td>
                            <td>@row.MemberNumber</td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="submit" class="btn btn-success">
                Import @Model.ValidRows.Count Controller@(Model.ValidRows.Count == 1 ? "" : "s")
            </button>
            <a asp-action="Import" class="btn btn-outline-secondary ms-2">Upload a Different File</a>
        </form>
    }
    else
    {
        <div class="alert alert-warning mt-3">No valid rows to import.</div>
        <a asp-action="Import" class="btn btn-outline-secondary">Upload a Different File</a>
    }
</div>
