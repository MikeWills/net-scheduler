@model List<NcsScheduler.Models.Domain.NetController>
@{ ViewData["Title"] = "Net Controllers"; }

<div class="mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Net Controllers</h2>
        @if (User.IsInRole("SuperAdmin"))
        {
            <div>
                <a asp-action="Create" class="btn btn-dark me-2">+ Add Controller</a>
                <a asp-controller="Invitation" asp-action="Send" class="btn btn-outline-dark">Send Invite</a>
            </div>
        }
    </div>

    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Callsign</th>
                <th>Member #</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Account</th>
                <th>Status</th>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var nc in Model)
            {
                <tr class="@(nc.IsActive ? "" : "table-secondary text-muted")">
                    <td class="fw-bold font-monospace">@nc.Callsign</td>
                    <td>@nc.MemberNumber</td>
                    <td>@nc.Name</td>
                    <td><a href="mailto:@nc.Email">@nc.Email</a></td>
                    <td>@nc.Phone</td>
                    <td>
                        @if (nc.UserId is not null)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No account</span>
                        }
                    </td>
                    <td>
                        @if (nc.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@nc.Id" class="btn btn-sm btn-outline-dark me-1">Edit</a>
                            @if (nc.IsActive)
                            {
                                <form asp-action="SetActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@nc.Id" />
                                    <input type="hidden" name="active" value="false" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Deactivate @nc.Callsign?')">Deactivate</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="SetActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@nc.Id" />
                                    <input type="hidden" name="active" value="true" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
