@model NcsScheduler.Models.ViewModels.HolidayEditViewModel
@{ ViewData["Title"] = "Edit Holiday"; ViewData["HelpPage"] = "Admin-User-Guide#holidays"; }

<div class="mt-3">
    <h2>Edit Holiday</h2>
    <form asp-action="Edit" method="post" class="mt-3" style="max-width: 500px;">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <partial name="_HolidayForm" model="Model" />
    </form>
</div>
