@model NcsScheduler.Models.ViewModels.HolidayIndexViewModel
@{ ViewData["Title"] = "Holiday Schedule"; ViewData["HelpPage"] = "Admin-User-Guide#holidays"; }

<div class="mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Holiday Schedule</h2>
        <a asp-action="Create" asp-route-year="@Model.SelectedYear" class="btn btn-secondary">+ Add Holiday</a>
    </div>

    @if (TempData["Success"] is string msg)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @msg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex align-items-center gap-2 mb-3">
        <form method="get" class="d-flex align-items-center gap-2">
            <label for="year" class="form-label mb-0 fw-bold">Year:</label>
            <select name="year" id="year" class="form-select form-select-sm" style="width:auto;"
                    onchange="this.form.submit()">
                @foreach (var y in Model.AvailableYears)
                {
                    <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                }
            </select>
        </form>

        <form asp-action="Generate" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="year" value="@Model.SelectedYear" />
            <button type="submit" class="btn btn-outline-primary btn-sm">
                Generate @Model.SelectedYear Holidays
            </button>
        </form>
    </div>

    @if (!Model.Holidays.Any())
    {
        <div class="alert alert-info">
            No holidays found for @Model.SelectedYear. Click <strong>Generate @Model.SelectedYear Holidays</strong>
            to auto-populate the federal holiday schedule.
        </div>
    }
    else
    {
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Date</th>
                    <th>Day</th>
                    <th>Holiday</th>
                    <th>Type</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.Holidays)
                {
                    <tr>
                        <td>@h.Date.ToString("MMM d, yyyy")</td>
                        <td>@h.Date.DayOfWeek</td>
                        <td class="fw-bold">@h.Name</td>
                        <td>
                            @if (h.IsAutoGenerated)
                            {
                                <span class="badge bg-success">Auto</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Manual</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@h.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@h.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this holiday?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
