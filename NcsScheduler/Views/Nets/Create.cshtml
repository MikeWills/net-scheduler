@model NcsScheduler.Models.ViewModels.NetEditViewModel
@{ ViewData["Title"] = "Create Net"; ViewData["HelpPage"] = "Admin-User-Guide#creating-a-net"; }

<div class="row justify-content-center mt-3">
    <div class="col-md-7">
        <h2>Create Net</h2>
        <form asp-action="Create" method="post">
            @await Html.PartialAsync("_NetForm", Model)
            <button type="submit" class="btn btn-dark">Create</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
